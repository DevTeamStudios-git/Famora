# ---------------------------------------------------------------------------
# Famora environment configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` (and `.env.local` for local secrets) and fill in
# real values. NEVER commit `.env` files. Secrets such as the Supabase service
# role key and database passwords must only ever exist on the server.

# --- Supabase (public) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (server-only secrets) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- PostgreSQL (Prisma) ---
# DATABASE_URL is the pooled connection used at application runtime.
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
# DIRECT_URL is the direct connection used by Prisma Migrate / Studio.
DIRECT_URL=postgresql://postgres.xxxx:password@db.xxxx.supabase.co:5432/postgres

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional: Supabase CLI access token (local dev only) ---
# SUPABASE_ACCESS_TOKEN=